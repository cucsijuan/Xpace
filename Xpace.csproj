<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <RootNamespace>Xpace</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- The submodules build on their own -->
    <Compile Remove="external/**" />
  </ItemGroup>
  <ItemGroup>
    <!-- The native libraries (native/CMakeLists.txt) go with the assemblies of an exported game: the ones for the
         platform it is exported to (any, when it names none) -->
    <NativeLibrary Include="native/bin/*.so" Condition="!$(RuntimeIdentifier.StartsWith('win')) And !$(RuntimeIdentifier.StartsWith('osx'))" />
    <NativeLibrary Include="native/bin/*.dll" Condition="'$(RuntimeIdentifier)' == '' Or $(RuntimeIdentifier.StartsWith('win'))" />
    <NativeLibrary Include="native/bin/*.dylib" Condition="'$(RuntimeIdentifier)' == '' Or $(RuntimeIdentifier.StartsWith('osx'))" />
    <None Include="@(NativeLibrary)" Link="%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Internet play through Epic Online Services: only when the EOS SDK is there (EosSdkDir, see Directory.Build.props). -->
  <PropertyGroup Condition="Exists('$(EosSdkDir)/Source/Core/Common.cs') And Exists('external/godot-eos/src/GodotEos/GodotEos.csproj')">
    <DefineConstants>$(DefineConstants);XPACE_EOS</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(EosSdkDir)/Source/Core/Common.cs') And Exists('external/godot-eos/src/GodotEos/GodotEos.csproj')">
    <ProjectReference Include="external/godot-eos/src/GodotEos/GodotEos.csproj" />
  </ItemGroup>
</Project>
